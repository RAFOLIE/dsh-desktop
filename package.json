{
  "name": "dsh-desktop-plugin",
  "description": "Install and launch the dsh-desktop-windowos desktop shell: auto-downloads and auto-updates the exe from GitHub Releases, creates desktop shortcuts (app + web UI), and exposes a desktop_launch tool. First run of the unsigned exe shows Windows SmartScreen - click More info > Run anyway.",
  "version": "1.4.5",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RAFOLIE/dsh-desktop-windowos.git"
  },
  "main": "plugin/lib/index.js",
  "types": "plugin/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./plugin/lib/types/index.d.ts",
      "default": "./plugin/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/lib",
    "plugin/src",
    "plugin/cordis.patch.yml",
    "plugin/README.md"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
